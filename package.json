{
  "name": "war-loss-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "vite build --outDir dist/client && vite build --ssr server/index.ts --outDir dist/server",
    "start": "node dist/server/index.js",
    "test:server": "node scripts/check-server.mjs",
    "test:dev": "tsx scripts/check-dev.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:import": "tsx scripts/import-data.ts",
    "data:check": "tsx scripts/check-public.ts",
    "public:check": "tsx scripts/check-public.ts --git",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@reatom/core": "1001.3.0",
    "@reatom/react": "1001.0.1",
    "@tanstack/react-virtual": "3.14.21",
    "globe.gl": "2.46.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@reatom/vite": "1001.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csv-parse": "7.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
