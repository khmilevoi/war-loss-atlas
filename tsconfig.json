{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "react-jsx", "resolveJsonModule": true, "esModuleInterop": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "scripts", "tests", "vite.config.ts", "server"]
}
